# Daylight Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# Variables marked REQUIRED must be set for the app to start correctly.
# Variables marked OPTIONAL can be left blank — the related feature will be hidden.

# ── Admin Panel ───────────────────────────────────────────────────────────────
# Password to access /admin. Without this the login page returns a 503 error.
# REQUIRED
ADMIN_PASSWORD=

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Used by Calendar, Tasks, and Sheets integrations.
# 1. Go to console.cloud.google.com → Create a project
# 2. Enable: Google Calendar API, Google Tasks API, Google Sheets API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Use the OAuth Playground (developers.google.com/oauthplayground) to
#    exchange your credentials for a long-lived refresh token
# REQUIRED for calendar events, tasks, goals, anniversaries, and trip planner
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   docs.google.com/spreadsheets/d/<ID>/edit
# Sheet structure expected:
#   Sheet1 A1      — quote or message of the day
#   Sheet "Quotes" — col A: quote text, col B: author
#   Sheet "Goals"  — col A rows 2–10: family goals
# REQUIRED for the goals and quote sections
GOOGLE_SHEET_ID=

# ── Google Calendar IDs ───────────────────────────────────────────────────────
# Found in each calendar's settings page → "Calendar ID"
# OPTIONAL — the related card is hidden if not set
GOOGLE_CALENDAR_ID_ANNIVERSARY=
GOOGLE_CALENDAR_ID_TRIPS=

# Fallback general calendar ID (defaults to "primary" if not set)
# OPTIONAL
CALENDAR_ID=

# ── UniFi Network Controller ──────────────────────────────────────────────────
# Required only if you enable the Connectivity Monitor in /admin.
# Generate a key in your UniFi controller → Settings → API → Create API Key
# OPTIONAL
UNIFI_API_KEY=

# ── Ticketmaster ──────────────────────────────────────────────────────────────
# Required only if you enable the Events Carousel in /admin.
# Register for a free API key at developer.ticketmaster.com
# OPTIONAL
TICKETMASTER_API_KEY=
